{
  "name": "software-factory",
  "version": "0.3.0",
  "description": "Automated software factory: project templates with CI/CD and security, a Claude Code kit of agents, commands, skills and guard hooks, and a gated spec → plan → build → test → review → ship agent pipeline.",
  "type": "module",
  "bin": {
    "factory": "bin/factory.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "claude-kit",
    "schema"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "smoke": "node scripts/smoke.js",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "software-factory",
    "claude-code",
    "agents",
    "scaffolding",
    "ci-cd",
    "templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugustincst/software-factory.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
