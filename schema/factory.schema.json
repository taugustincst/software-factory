{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/taugustincst/software-factory/main/schema/factory.schema.json",
  "title": "factory.json",
  "description": "Canonical commands for a repository. CI, Claude Code hooks and the factory pipeline gates all run these.",
  "type": "object",
  "required": ["commands"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "commands": {
      "type": "object",
      "required": ["test"],
      "properties": {
        "install": {
          "type": "string",
          "description": "Install dependencies"
        },
        "lint": {
          "type": "string",
          "description": "Lint and format check; must exit non-zero on problems"
        },
        "typecheck": {
          "type": "string"
        },
        "test": {
          "type": "string",
          "description": "Full test suite"
        },
        "build": {
          "type": "string"
        },
        "dev": {
          "type": "string",
          "description": "Local development server (not run by gates)"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "models": {
      "type": "object",
      "description": "Models for the embedded roles (docs/self-improvement.md).",
      "properties": {
        "generative": {
          "type": ["string", "null"],
          "pattern": "^[\\w.:@/-]{1,100}$",
          "description": "Generative model: drafts improvement proposals."
        },
        "decision": {
          "type": ["string", "null"],
          "pattern": "^[\\w.:@/-]{1,100}$",
          "description": "Decision model: judges and ranks proposals; read-only."
        }
      },
      "additionalProperties": false
    },
    "improvement": {
      "type": "object",
      "description": "The self-improvement loop (docs/self-improvement.md).",
      "properties": {
        "afterRun": {
          "enum": ["evidence", "analyze", "off"],
          "description": "After each run: deterministic Steward pass (default), with models, or nothing."
        },
        "recurrenceMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Runs a fact must appear in to count as a pattern."
        },
        "maxProposalsPerRun": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "staleAfterRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Retire a proposal whose evidence has not recurred in this many runs."
        },
        "maxUsdPerPass": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "approval": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": ["required", "auto"],
              "description": "required (default): Tj approves every proposal. auto: the decision model may approve proposals at or below autoMaxRisk."
            },
            "autoMaxRisk": {
              "enum": ["low", "medium"],
              "description": "Highest computed risk auto mode may apply. Gates, security and release are always human."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "description": "The factory tool harness (docs/harness.md).",
      "properties": {
        "exec": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "description": "factory.json command names run_command may run."
        },
        "only": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]+$"
              }
            }
          ],
          "description": "Harness-only stages: true for every agent stage, or a list of stage ids. Those stages get only the factory's scoped tools (Claude Code's built-in tools are dropped)."
        }
      },
      "additionalProperties": false
    },
    "inspector": {
      "type": "object",
      "description": "The Inspector: release quality (docs/self-improvement.md).",
      "properties": {
        "rubric": {
          "type": "object",
          "description": "Per check: hold (blocks ship), note (ships with notes) or off.",
          "properties": {
            "gates-passed": {
              "enum": ["hold", "note", "off"]
            },
            "lint": {
              "enum": ["hold", "note", "off"]
            },
            "typecheck": {
              "enum": ["hold", "note", "off"]
            },
            "test": {
              "enum": ["hold", "note", "off"]
            },
            "coverage-delta": {
              "enum": ["hold", "note", "off"]
            },
            "secrets": {
              "enum": ["hold", "note", "off"]
            },
            "risky-diff": {
              "enum": ["hold", "note", "off"]
            },
            "version-changelog": {
              "enum": ["hold", "note", "off"]
            },
            "template-conformance": {
              "enum": ["hold", "note", "off"]
            },
            "model-review": {
              "enum": ["hold", "note", "off"]
            }
          },
          "additionalProperties": false
        },
        "coverageDropMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Largest acceptable drop in line coverage, in points, against the last inspected run."
        },
        "analyze": {
          "type": "boolean",
          "description": "Also run the model Inspector (factory-inspector). It can add a hold; it cannot clear one."
        },
        "model": {
          "type": ["string", "null"],
          "pattern": "^[\\w.:@/-]{1,100}$",
          "description": "Model for the Inspector; null uses the executor default."
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "description": "LLM providers beyond the built-ins (docs/providers.md). Keys come only from the environment variable named in apiKeyEnv.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": ["claude-code", "anthropic", "openai", "mock"]
          },
          "baseUrl": {
            "type": "string",
            "description": "https, or http to localhost only"
          },
          "apiKeyEnv": {
            "type": ["string", "null"],
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "model": {
            "type": "string"
          },
          "price": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["input", "output"],
            "additionalProperties": false,
            "description": "USD per million tokens"
          },
          "maxTurns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64000
          }
        },
        "not": {
          "required": ["apiKey"]
        },
        "additionalProperties": false
      }
    },
    "routing": {
      "type": "object",
      "description": "Which LLM each stage or role uses (docs/providers.md).",
      "properties": {
        "default": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,30}(:[\\w.:@/-]{1,100})?$",
            "description": "\"<provider>\" or \"<provider>:<model>\""
          },
          "description": "Routes tried in order; the first available one runs."
        },
        "stages": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,30}(:[\\w.:@/-]{1,100})?$",
              "description": "\"<provider>\" or \"<provider>:<model>\""
            },
            "description": "Routes tried in order; the first available one runs."
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,30}(:[\\w.:@/-]{1,100})?$",
              "description": "\"<provider>\" or \"<provider>:<model>\""
            },
            "description": "Routes tried in order; the first available one runs."
          }
        },
        "escalateOnRetry": {
          "type": "boolean",
          "description": "A retry after a failed gate starts one step further down the chain."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
