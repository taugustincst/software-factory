# Environment variables the software factory reads. All are optional for
# local development; copy to .env only if you need to set one. Never commit
# a real .env file.

# Milliseconds of artificial delay for the mock executor (offline demos/tests).
# FACTORY_MOCK_DELAY_MS=0

# Set by GitHub Actions; the CLI appends run outputs (status, run_id, pr_url)
# to this file when it is present. No local action needed.
# GITHUB_OUTPUT=

# Git identity fallbacks used for the scaffold first commit when the machine
# has no git user.name/user.email configured.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# Note: the factory never reads an Anthropic API key itself. Pipeline runs
# use the Claude Code CLI's own login locally, or the ANTHROPIC_API_KEY
# repository secret in the generated factory.yml workflow (a dedicated,
# spend-capped key — see docs/threat-model.md).
