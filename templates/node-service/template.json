{
  "title": "Node integration service",
  "stack": "Node 24 · TypeScript · Fastify · Zod · Vitest · Docker",
  "defaultDescription": "HTTP integration service",
  "vars": {
    "codeqlLanguage": "javascript-typescript",
    "dependabotEcosystem": "npm",
    "releaseType": "node"
  },
  "commands": {
    "install": "npm install",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm test",
    "coverage": "npx vitest run --coverage",
    "build": "npm run build",
    "dev": "npm run dev"
  },
  "postCreate": ["npm run format"]
}
