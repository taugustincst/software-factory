{
  "title": "Node integration service",
  "stack": "Node 24 · TypeScript · Fastify · Zod · Postgres 16 · Drizzle · session auth (argon2id) · OpenTelemetry (opt-in) · Vitest · Docker · GHCR deploy stub (opt-in)",
  "defaultDescription": "HTTP integration service",
  "vars": {
    "codeqlLanguage": "javascript-typescript",
    "dependabotEcosystem": "npm",
    "releaseType": "node"
  },
  "commands": {
    "install": "npm install",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm test",
    "coverage": "npx vitest run --coverage",
    "build": "npm run build",
    "migrate": "npm run db:migrate",
    "dev": "npm run dev"
  },
  "postCreate": ["npm run format"]
}
