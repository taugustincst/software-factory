#!/bin/sh
# Pre-commit hook for factory-scaffolded projects: run the project's lint
# command (from factory.json) when any file is staged, so a red lint never
# reaches CI. Enable once per clone:  git config core.hooksPath .githooks
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

lint=""
if [ -f factory.json ] && command -v node >/dev/null 2>&1; then
  lint=$(node -e "try{process.stdout.write(JSON.parse(require('fs').readFileSync('factory.json','utf8')).commands?.lint??'')}catch{}")
fi
if [ -z "$lint" ] && [ -f package.json ]; then
  lint="npm run lint"
fi
if [ -z "$lint" ] && [ -f pyproject.toml ] && command -v uv >/dev/null 2>&1; then
  lint="uv run ruff check . && uv run ruff format --check ."
fi
if [ -z "$lint" ]; then
  echo "pre-commit: no lint command found (factory.json / package.json / pyproject.toml); skipping" >&2
  exit 0
fi

echo "pre-commit: running lint: $lint"
sh -c "$lint"
