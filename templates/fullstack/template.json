{
  "title": "Full-stack web app",
  "stack": "React 19 · Vite · TypeScript · Fastify API · Postgres 16 · Drizzle · session auth (argon2id) · OpenTelemetry (opt-in) · Vitest + Testing Library · Playwright e2e · Docker",
  "defaultDescription": "Full-stack web application",
  "vars": {
    "codeqlLanguage": "javascript-typescript",
    "dependabotEcosystem": "npm",
    "releaseType": "node"
  },
  "commands": {
    "install": "npm install",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm test",
    "coverage": "npx vitest run --coverage",
    "build": "npm run build",
    "e2e": "npm run e2e",
    "migrate": "npm run db:migrate",
    "dev": "npm run dev"
  },
  "postCreate": ["npm run format"]
}
