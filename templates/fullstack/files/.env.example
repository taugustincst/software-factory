# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Postgres connection string. Default matches docker-compose.yml (npm run db:up).
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
# Session auth. SESSION_SECRET keys the HMAC of stored session tokens; the
# built-in default is DEV-ONLY (the app refuses to start in production with
# it). Set a real random secret of at least 32 characters in production.
# SESSION_SECRET=
SESSION_TTL_HOURS=168
# OpenTelemetry tracing (optional, OFF unless the endpoint is set).
# Point the base endpoint at an OTLP/HTTP collector (the /v1/traces path is
# appended automatically); OTEL_SERVICE_NAME labels this service's spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=fullstack
# OTEL_SDK_DISABLED=false
